#!/bin/bash
# notes-commit: commit everything changed in the notes repository with a described message.
#
#   tools/notes-commit "what changed and why"       commit only
#   tools/notes-commit -p "message"                 also mirror/push afterwards (tools/mirror-push.sh)
#   tools/notes-commit --human "message"            no AI co-author trailer
#   tools/notes-commit --tag audit-2026-11-03 "message"   also create a milestone tag
#   tools/notes-commit --branch my-change "message"  commit on that branch (created from the current one if new)
#   tools/notes-commit --push "message"             also git push the current branch to origin (sets the upstream)
#   tools/notes-commit --pr "message"               --push, then open a pull request with the GitHub CLI (gh pr create --fill)
#
# Behaviour (configured in .living-notes.conf at the repository root):
#   - stages everything (respecting .gitignore); says "nothing to commit" and exits 0 when clean
#   - syntax-checks changed shell and python files before committing (CHECK_SH / CHECK_PY)
#   - the pre-commit hook (tools/hooks/pre-commit) refuses commits that add secret-looking lines
#   - adds AGENT_TRAILER unless --human
#   - after the commit, if a changed file matches SYNC_GLOBS, runs SYNC_CMD so the live copy equals the committed copy
#   - with -p runs tools/mirror-push.sh
#   - team use: --branch / --push / --pr give each change its own branch and pull request (see docs/TEAM.md)
set -eo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
root="$(git -C "${NOTES_ROOT:-$PWD}" rev-parse --show-toplevel 2>/dev/null || git -C "$here" rev-parse --show-toplevel)"
cd "$root"
[ -f .living-notes.conf ] && . ./.living-notes.conf
: "${CHECK_SH:=1}" "${CHECK_PY:=1}" "${AGENT_TRAILER:=}" "${SYNC_GLOBS:=}" "${SYNC_CMD:=}"

push=0; trailer=1; tag=""; branch=""; gitpush=0; pr=0
while [ "${1:0:1}" = "-" ]; do
  case "$1" in
    -p) push=1;;
    --human) trailer=0;;
    --tag) shift; tag="$1";;
    --branch) shift; branch="$1";;
    --push) gitpush=1;;
    --pr) gitpush=1; pr=1;;
    -h|--help) sed -n '2,20p' "$0"; exit 0;;
    *) echo "notes-commit: unknown option $1" >&2; exit 2;;
  esac
  shift
done
msg="$*"
[ -n "$msg" ] || { echo "usage: notes-commit [-p] [--human] [--tag NAME] [--branch NAME] [--push|--pr] \"message\"" >&2; exit 2; }

if [ -n "$branch" ] && [ "$(git symbolic-ref -q --short HEAD)" != "$branch" ]; then
  if git show-ref -q --verify "refs/heads/$branch"; then git switch -q "$branch"; else git switch -q -c "$branch"; fi
  echo "notes-commit: on branch $branch"
fi
git add -A
if git diff --cached --quiet; then echo "notes-commit: nothing to commit"; exit 0; fi

changed="$(git diff --cached --name-only --diff-filter=AM)"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.sh|tools/notes-commit|tools/hooks/*) [ "$CHECK_SH" = 1 ] && { bash -n "$f" || { echo "notes-commit: syntax error in $f, not committing" >&2; exit 1; }; };;
    *.py) [ "$CHECK_PY" = 1 ] && { python3 -m py_compile "$f" || { echo "notes-commit: syntax error in $f, not committing" >&2; exit 1; }; };;
  esac
done <<< "$changed"

if [ "$trailer" = 1 ] && [ -n "$AGENT_TRAILER" ]; then msg="$msg

$AGENT_TRAILER"; fi
git commit -q -m "$msg"
git log --oneline -1
git show --stat --format= HEAD | tail -n 6
[ -z "$tag" ] || { git tag "$tag" && echo "tagged $tag"; }

if [ -n "$SYNC_GLOBS" ] && [ -n "$SYNC_CMD" ]; then
  hit=0
  for g in $SYNC_GLOBS; do
    while IFS= read -r f; do
      # shellcheck disable=SC2254
      case "$f" in $g) hit=1;; esac
    done <<< "$changed"
  done
  if [ "$hit" = 1 ]; then bash -c "$SYNC_CMD" || echo "WARNING: committed, but SYNC_CMD failed; the live copy may differ from the committed copy" >&2; fi
fi

if [ "$push" = 1 ]; then "$here/mirror-push.sh" || echo "WARNING: committed, but the mirror push failed" >&2; fi

if [ "$gitpush" = 1 ]; then
  cur="$(git symbolic-ref -q --short HEAD || true)"
  [ -n "$cur" ] || { echo "WARNING: detached HEAD, not pushing" >&2; exit 0; }
  if git remote get-url origin >/dev/null 2>&1; then
    git push -q -u origin "$cur" && echo "pushed $cur to origin" || echo "WARNING: committed, but git push failed" >&2
    if [ "$pr" = 1 ]; then
      if command -v gh >/dev/null; then gh pr create --fill || echo "WARNING: pull request not created (does one exist already?)" >&2
      else echo "gh (GitHub CLI) not installed: open a pull request for branch $cur in your hosting service"; fi
    fi
  else echo "WARNING: no remote named origin; nothing pushed" >&2; fi
fi
